<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AsteroidOnline.Client.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:Class="AsteroidOnline.Client.Views.GameOverView"
             x:DataType="vm:GameOverViewModel"
             Background="#070A12">

  <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
    <Border CornerRadius="12"
            Background="#C00A121F"
            BorderBrush="#55FFB964"
            BorderThickness="1"
            Padding="30">
      <StackPanel Spacing="12">
        <TextBlock Text="MISSION TERMINÉE"
                   FontSize="38"
                   FontWeight="Bold"
                   Foreground="#FFCD72"
                   HorizontalAlignment="Center"
                   LetterSpacing="2.4" />

        <TextBlock Text="{Binding WinnerName, StringFormat=Leader : {0}}"
                   IsVisible="{Binding ShowWinner}"
                   FontSize="21"
                   Foreground="#E8F4FF"
                   HorizontalAlignment="Center" />

        <TextBlock Text="{Binding FinalScore, StringFormat=Score personnel : {0}}"
                   FontSize="20"
                   Foreground="#A9D6FF"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" />

        <Border CornerRadius="8"
                Background="#8A07101D"
                BorderBrush="#446BC7FF"
                BorderThickness="1"
                Padding="12"
                Margin="0,6,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="CLASSEMENT FINAL"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#FFCD72"
                       HorizontalAlignment="Center"
                       LetterSpacing="1.6" />
            <ItemsControl ItemsSource="{Binding FinalRanking}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FinalRankingEntry">
                  <Grid ColumnDefinitions="42,*,92,92" Margin="0,2">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Rank, StringFormat=# {0}}"
                               Foreground="#8BD7FF"
                               FontSize="12" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding PlayerName}"
                               Foreground="#EEF6FF"
                               FontSize="12" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Score, StringFormat={}{0} pts}"
                               Foreground="#FFD47B"
                               FontSize="12"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding StatusText}"
                               Foreground="#8FE6A2"
                               FontSize="12"
                               HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Button Content="RETOUR AU LOBBY"
                Command="{Binding ReturnToLobbyCommand}"
                HorizontalAlignment="Stretch"
                FontWeight="Bold"
                FontSize="16"
                Padding="0,14"
                CornerRadius="6"
                Margin="0,12,0,0"
                Background="#FFCC59"
                Foreground="#101620" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
