<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AsteroidOnline.Client.ViewModels"
             xmlns:conv="using:AsteroidOnline.Client.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="AsteroidOnline.Client.Views.ConnectView"
             x:DataType="vm:ConnectViewModel"
             Background="#070A12">

  <UserControl.Resources>
    <SolidColorBrush x:Key="TextControlBackground" Color="White" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White" />
    <SolidColorBrush x:Key="TextControlForeground" Color="Black" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="Black" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="Black" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#202020" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#202020" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#202020" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#666666" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#666666" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#666666" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#0067C0" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBox.PlainInput">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="Black" />
      <Setter Property="CaretBrush" Value="Black" />
      <Setter Property="SelectionBrush" Value="#0067C0" />
      <Setter Property="SelectionForegroundBrush" Value="White" />
      <Setter Property="BorderBrush" Value="#202020" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontFamily" Value="Consolas, Courier New" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBox.PlainInput:pointerover">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="Black" />
      <Setter Property="CaretBrush" Value="Black" />
      <Setter Property="SelectionBrush" Value="#0067C0" />
      <Setter Property="SelectionForegroundBrush" Value="White" />
      <Setter Property="BorderBrush" Value="#202020" />
    </Style>
    <Style Selector="TextBox.PlainInput:focus">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="Black" />
      <Setter Property="CaretBrush" Value="Black" />
      <Setter Property="SelectionBrush" Value="#0067C0" />
      <Setter Property="SelectionForegroundBrush" Value="White" />
      <Setter Property="BorderBrush" Value="#202020" />
    </Style>
    <Style Selector="TextBox.PlainInput /template/ Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#202020" />
    </Style>
    <Style Selector="TextBox.PlainInput:pointerover /template/ Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#202020" />
    </Style>
    <Style Selector="TextBox.PlainInput:focus /template/ Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#202020" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Border Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="26"
            CornerRadius="12"
            Background="#BE0A1220"
            BorderBrush="#55FFB95F"
            BorderThickness="1">
      <StackPanel Spacing="10">
        <TextBlock Text="ASTEROID ONLINE"
                   FontSize="38"
                   FontWeight="Bold"
                   Foreground="#FFCC6F"
                   HorizontalAlignment="Center"
                   LetterSpacing="2.8" />
        <TextBlock Text="Arcade survival • équipe jusqu'à 20 pilotes"
                   FontSize="14"
                   Foreground="#9CC6EB"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,6" />

        <TextBlock Text="PSEUDO" Foreground="#91B5D4" FontSize="11" FontWeight="SemiBold" LetterSpacing="2" />
        <TextBox Text="{Binding Pseudo}"
                 Classes="PlainInput"
                 Watermark="Votre pseudo (1-20 caractères)"
                 MaxLength="20" />

        <TextBlock Text="SERVEUR" Foreground="#91B5D4" FontSize="11" FontWeight="SemiBold" LetterSpacing="2" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="*,8,95">
          <TextBox Grid.Column="0"
                   Classes="PlainInput"
                   Text="{Binding ServerAddress}"
                   Watermark="127.0.0.1" />
          <TextBox Grid.Column="2"
                   Classes="PlainInput"
                   Text="{Binding ServerPort}"
                   Watermark="7777" />
        </Grid>

        <TextBlock Text="COULEUR DU VAISSEAU" Foreground="#91B5D4" FontSize="11" FontWeight="SemiBold" LetterSpacing="2" Margin="0,8,0,0" />
        <ListBox ItemsSource="{Binding AvailableColors}"
                 SelectedItem="{Binding SelectedColorOption}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PlayerColorOption">
              <Border CornerRadius="6"
                      Padding="10,6"
                      Margin="4"
                      Background="#111E32"
                      BorderThickness="1.5"
                      BorderBrush="{Binding HexColor, Converter={x:Static conv:StringToBrushConverter.Instance}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="14" Height="14"
                           Fill="{Binding HexColor, Converter={x:Static conv:StringToBrushConverter.Instance}}" />
                  <TextBlock Text="{Binding Name}" Foreground="#EEF6FF" FontSize="13" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button Content="REJOINDRE LE LOBBY"
                Command="{Binding ConnectCommand}"
                HorizontalAlignment="Stretch"
                FontWeight="Bold"
                FontSize="16"
                Padding="0,14"
                CornerRadius="6"
                Background="#FFCC59"
                Foreground="#101620"
                Margin="0,8,0,0" />

        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{Binding ConnectionStatus, Converter={x:Static conv:ConnectionStatusToBrushConverter.Instance}}"
                   HorizontalAlignment="Center"
                   FontSize="13"
                   Margin="0,6,0,0"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
